---
// Fontes servidas pelo próprio site (sem Google Fonts). Archivo com eixo de largura, para os títulos condensados.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  tipo?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  // Só para artigos: alimentam as tags article:* do Open Graph.
  artigo?: { publicado: Date; modificado?: Date; secao: string };
  noindex?: boolean;
}

const { title, description = SITE.descricao, keywords = [], tipo = 'website', jsonLd, artigo, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL(SITE.imagemPadrao, Astro.site);
const tituloCompleto = title === SITE.nome ? title : `${title} | ${SITE.nome}`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.nome} />
    {artigo && <meta property="article:published_time" content={artigo.publicado.toISOString()} />}
    {artigo?.modificado && <meta property="article:modified_time" content={artigo.modificado.toISOString()} />}
    {artigo && <meta property="article:section" content={artigo.secao} />}
    {artigo && <meta property="article:author" content={SITE.autor.nome} />}
    {artigo && keywords.map((k) => <meta property="article:tag" content={k} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content={SITE.autor.nome} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.nome} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <Cabecalho />
    <main>
      <slot />
    </main>
    <Rodape />
  </body>
</html>
