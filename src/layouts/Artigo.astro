---
import Base from './Base.astro';
import LeadGate from '../components/LeadGate.astro';
import { SITE } from '../site.config';
import { dataBR } from '../scripts/formatos';
import { instituicoes } from '../scripts/fontes';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  keywords: string[];
  fontes: { titulo: string; url: string }[];
  gate: boolean;
  secao: { nome: string; href: string };
  leitura: number;
  pais?: string;
}

const { title, description, date, updated, keywords, fontes, gate: gateDoTexto, secao, leitura, pais } = Astro.props;
// Com o pop-up desligado em SITE.lead.ativo, nenhum texto fica restrito.
const gate = gateDoTexto && SITE.lead.ativo;

// As matérias não levam assinatura visível; o autor continua nos metadados para o Google,
// e o blog aparece como publicador.
const autor = {
  '@type': 'Person',
  name: SITE.autor.nome,
  description: SITE.autor.credenciais.join('; '),
};
const publicador = { '@type': 'Organization', name: SITE.nome, url: new URL('/', Astro.site).href };
const instituicoesCitadas = instituicoes(fontes);

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': secao.href.startsWith('/noticias') ? 'NewsArticle' : 'Article',
  headline: title,
  description,
  image: [new URL(SITE.imagemPadrao, Astro.site).href],
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: 'pt-BR',
  articleSection: secao.nome,
  keywords: keywords.join(', '),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: autor,
  publisher: publicador,
};

if (pais) jsonLd.contentLocation = { '@type': 'Place', name: pais };

// Marcação recomendada pelo Google para conteúdo que pede cadastro:
// evita que o bloqueio seja tratado como cloaking.
if (gate) {
  jsonLd.isAccessibleForFree = false;
  jsonLd.hasPart = { '@type': 'WebPageElement', isAccessibleForFree: false, cssSelector: '.artigo-corpo' };
}
---
<Base
  title={title}
  description={description}
  keywords={keywords}
  tipo="article"
  jsonLd={jsonLd}
  artigo={{ publicado: date, modificado: updated, secao: secao.nome }}
>
  <article class="artigo container-texto">
    <header class="artigo-cabecalho">
      <a class="etiqueta" href={secao.href}>{secao.nome}</a>
      <h1>{title}</h1>
      <p class="linha-fina">{description}</p>
      <div class="assinatura">
        {instituicoesCitadas.length > 0 && (
          <p class="fontes-linha">
            <span class="rotulo">{instituicoesCitadas.length > 1 ? 'Fontes' : 'Fonte'}</span>
            {instituicoesCitadas.map((f, i) => (
              <>{i > 0 && ', '}<a href={f.url} rel="noopener" target="_blank">{f.nome}</a></>
            ))}
          </p>
        )}
        <p class="meta meta-artigo">
          <span><time datetime={date.toISOString()}>{dataBR(date)}</time></span>
          {updated && <span>atualizado em <time datetime={updated.toISOString()}>{dataBR(updated)}</time></span>}
          {pais && <span>{pais}</span>}
          <span>{leitura} min de leitura</span>
        </p>
      </div>
    </header>

    <div class="artigo-corpo" data-gate={gate ? 'true' : 'false'}>
      <slot />
    </div>

    {fontes.length > 0 && (
      <section class="fontes" id="fontes">
        <h2>Fontes</h2>
        <ol>
          {fontes.map((f) => (
            <li><a href={f.url} rel="noopener" target="_blank">{f.titulo}</a></li>
          ))}
        </ol>
      </section>
    )}

    <p class="aviso">
      Este texto tem caráter educacional e não é recomendação de investimento. Rentabilidade passada não
      garante rentabilidade futura. Avalie qualquer decisão de acordo com o seu perfil de investidor.
    </p>
  </article>
  {gate && <LeadGate />}
  <div class="progresso" id="progresso" aria-hidden="true"></div>
</Base>

<script>
  // Barra fina no topo que acompanha a leitura do corpo do texto.
  const barra = document.getElementById('progresso');
  const corpo = document.querySelector<HTMLElement>('.artigo-corpo');
  if (barra && corpo) {
    let pendente = false;
    const atualizar = () => {
      pendente = false;
      const r = corpo.getBoundingClientRect();
      // Mesma linha de leitura do pop-up: 60% da altura da tela.
      const lido = (window.innerHeight * 0.6 - r.top) / r.height;
      barra.style.transform = `scaleX(${Math.min(1, Math.max(0, lido))})`;
    };
    const agendar = () => {
      if (!pendente) {
        pendente = true;
        requestAnimationFrame(atualizar);
      }
    };
    window.addEventListener('scroll', agendar, { passive: true });
    window.addEventListener('resize', agendar, { passive: true });
    atualizar();
  }
</script>
