---
import { SITE } from '../site.config';
---
{SITE.tarja.ativo && (
  <section class="tarja" aria-label="Cotações" data-endpoint={SITE.tarja.endpoint} data-intervalo={SITE.tarja.intervaloSegundos} data-ptax-url={SITE.tarja.ptaxUrl}>
    <div class="container tarja-linha">
      <div class="tarja-janela" tabindex="0" role="button" aria-pressed="false" aria-label="Cotações do Ibovespa, de ações do índice e do dólar PTAX. Clique para parar ou continuar a rolagem.">
        <div class="tarja-trilho" data-trilho></div>
      </div>
      <span class="tarja-fonte">B3 e Banco Central</span>
    </div>
  </section>
)}

<script>
  import papeis from '../data/tarja.json';
  import { URL_B3, lerCotacaoB3 } from '../../functions/_lib/cotacoes.js';
  import { buscarFuncao } from '../scripts/cotacoes';

  const secao = document.querySelector<HTMLElement>('.tarja');

  interface Item { simbolo: string; nome: string; preco: number; variacao: number | null }
  interface Ptax { valor: number; variacao: number | null; data: string | null }
  interface Resposta { itens: Item[]; ptax: Ptax | null }

  const NUM = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const PONTOS = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 0 });
  const PTAX = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 4, maximumFractionDigits: 4 });

  const sinal = (v: number | null) => (v === null || Math.abs(v) < 0.005 ? 'igual' : v > 0 ? 'alta' : 'baixa');
  const seta = { alta: '▲', baixa: '▼', igual: '' } as const;
  const variacaoTexto = (v: number | null) => (v === null ? '' : `${v > 0 ? '+' : ''}${NUM.format(v)}%`);

  const linha = (id: string, rotulo: string, nomeCompleto: string, valor: string, variacao: number | null, href?: string) => {
    const tipo = sinal(variacao);
    const el = document.createElement(href ? 'a' : 'span');
    el.className = `tarja-item tarja-${tipo}`;
    el.dataset.id = id;
    el.title = nomeCompleto;
    if (href) {
      (el as HTMLAnchorElement).href = href;
      (el as HTMLAnchorElement).rel = 'noopener';
      (el as HTMLAnchorElement).target = '_blank';
    }
    el.innerHTML = `<b></b><span class="valor"></span><span class="var"></span>`;
    preencher(el, rotulo, valor, variacao);
    return el;
  };

  const preencher = (el: Element, rotulo: string, valor: string, variacao: number | null) => {
    const tipo = sinal(variacao);
    el.className = el.className.replace(/tarja-(alta|baixa|igual)/, `tarja-${tipo}`);
    el.querySelector('b')!.textContent = rotulo;
    el.querySelector('.valor')!.textContent = valor;
    el.querySelector('.var')!.textContent = `${seta[tipo]} ${variacaoTexto(variacao)}`.trim();
  };

  const lista = (r: Resposta) => [
    ...r.itens.map((i) => ({
      id: i.simbolo,
      rotulo: i.simbolo === 'IBOV' ? 'Ibovespa' : i.simbolo,
      nome: i.nome,
      valor: i.simbolo === 'IBOV' ? `${PONTOS.format(i.preco)} pts` : NUM.format(i.preco),
      variacao: i.variacao,
      href: undefined as string | undefined,
    })),
    ...(r.ptax
      ? [{ id: 'PTAX', rotulo: 'Dólar PTAX', nome: `PTAX de venda do Banco Central${r.ptax.data ? `, ${r.ptax.data}` : ''}`, valor: `R$ ${PTAX.format(r.ptax.valor)}`, variacao: r.ptax.variacao, href: secao?.dataset.ptaxUrl }]
      : []),
  ];

  async function iniciar(el: HTMLElement) {
    const trilho = el.querySelector<HTMLElement>('[data-trilho]')!;

    let ids = '';

    // Ações e índice: direto da B3 no navegador do leitor (a B3 libera CORS e recusa consultas vindas da Cloudflare).
    // PTAX: pela função /api/cotacoes, que lê o Banco Central. Cada fonte falha sozinha.
    const daB3 = (s: string) =>
      fetch(URL_B3(s), { headers: { Accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : null))
        .then((j) => (j ? (lerCotacaoB3(j) as Item | null) : null))
        .catch(() => null);
    const daFuncao = () => buscarFuncao() as Promise<Resposta | null>;

    function montar(itens: ReturnType<typeof lista>) {
      trilho.replaceChildren();
      // Duas cópias iguais: a rolagem anda metade da largura e recomeça sem salto. A segunda é só visual.
      for (const copia of [0, 1]) {
        const ul = document.createElement('div');
        ul.className = 'tarja-copia';
        if (copia === 1) ul.setAttribute('aria-hidden', 'true');
        for (const i of itens) {
          const item = linha(i.id, i.rotulo, i.nome, i.valor, i.variacao, i.href);
          if (copia === 1) item.tabIndex = -1;
          ul.append(item);
        }
        trilho.append(ul);
      }
      el.classList.add('pronta');
      requestAnimationFrame(() => {
        const largura = trilho.firstElementChild!.getBoundingClientRect().width;
        trilho.style.setProperty('--duracao', `${Math.max(15, Math.round(largura / 90))}s`);
      });
    }

    async function atualizar() {
      if (document.hidden) return;
      const [b3, funcao] = await Promise.all([Promise.all([papeis.indice, ...papeis.acoes].map(daB3)), daFuncao()]);
      const doNavegador = b3.filter((i): i is Item => i !== null);
      // Se a B3 não respondeu no navegador, usa o que a função conseguiu (se conseguiu).
      const itens = lista({ itens: doNavegador.length ? doNavegador : (funcao?.itens ?? []), ptax: funcao?.ptax ?? null });
      if (itens.length === 0) return; // nada a mostrar: mantém o que já está na tela, ou a tarja escondida
      const novosIds = itens.map((i) => i.id).join(',');
      if (novosIds !== ids) {
        montar(itens);
        ids = novosIds;
      } else {
        // Atualiza no lugar, sem refazer a lista: a rolagem não reinicia.
        for (const i of itens) {
          trilho.querySelectorAll(`[data-id="${i.id}"]`).forEach((n) => preencher(n, i.rotulo, i.valor, i.variacao));
        }
      }
    }

    // Clique (ou Enter/Espaço) para e retoma a rolagem. O link da PTAX continua abrindo normalmente.
    const janela = el.querySelector<HTMLElement>('.tarja-janela')!;
    const alternar = () => {
      const parada = janela.classList.toggle('parada');
      janela.setAttribute('aria-pressed', String(parada));
    };
    janela.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('a')) alternar();
    });
    janela.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        alternar();
      }
    });

    await atualizar();
    setInterval(atualizar, Math.max(30, Number(el.dataset.intervalo) || 60) * 1000);
    document.addEventListener('visibilitychange', () => !document.hidden && atualizar());
  }

  if (secao) iniciar(secao);
</script>
