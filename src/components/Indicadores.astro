---
import dados from '../data/indicadores.json';

// Cada item: { nome, valor, data, fonte, url }. Item incompleto não aparece:
// a faixa nunca mostra número sem fonte e sem data.
interface Indicador { nome: string; valor: string; data: string; fonte: string; url: string }
const itens = ((dados as { itens?: Indicador[] }).itens ?? []).filter(
  (i) => i.nome && i.valor && i.data && i.fonte && /^https:\/\//.test(i.url)
);
---
{itens.length > 0 && (
  <aside class="indicadores" aria-label="Indicadores">
    <div class="container">
      {itens.map((i) => (
        <a class="indicador" data-nome={i.nome} href={i.url} rel="noopener" target="_blank" title={`${i.fonte}, ${i.data}`}>
          <strong>{i.nome}</strong>
          <span class="valor">{i.valor}</span>
          <span class="meta">{i.data}</span>
        </a>
      ))}
    </div>
  </aside>
)}

<script>
  // Troca os valores gravados no build pelos da função (Banco Central e IBGE ao vivo). Sem resposta, fica o do build.
  import { buscarFuncao } from '../scripts/cotacoes';

  buscarFuncao().then((r) => {
    for (const i of r?.indicadores ?? []) {
      const el = document.querySelector<HTMLAnchorElement>(`.indicador[data-nome="${CSS.escape(i.nome)}"]`);
      if (!el) continue;
      el.querySelector('.valor')!.textContent = i.valor;
      el.querySelector('.meta')!.textContent = i.data;
      el.title = el.title.replace(/, .*$/, `, ${i.data}`);
    }
  });
</script>
