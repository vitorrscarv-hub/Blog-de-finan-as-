---
import { dataBR } from '../scripts/formatos';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  etiqueta?: string;
  etiquetaHref?: string;
}
const { href, title, description, date, etiqueta, etiquetaHref } = Astro.props;
---
<article class="card">
  {etiqueta && (etiquetaHref ? <a class="etiqueta" href={etiquetaHref}>{etiqueta}</a> : <span class="etiqueta">{etiqueta}</span>)}
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <time class="meta" datetime={date.toISOString()}>{dataBR(date)}</time>
</article>
