---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CardPost from '../components/CardPost.astro';
import ContatoEspecialista from '../components/ContatoEspecialista.astro';
import { SITE } from '../site.config';
import { porData, publicado } from '../scripts/formatos';
import { selecaoPatrimonio } from '../scripts/patrimonio';

const noticias = (await getCollection('noticias', publicado)).sort(porData);
const guias = (await getCollection('guias', publicado)).sort(porData);
const itens = selecaoPatrimonio(noticias, guias);
---
<Base title="Seu patrimônio" description="Matérias e guias sobre proteção, diversificação e patrimônio no exterior, reunidos em um só lugar.">
  <section class="container">
    <header class="pagina-titulo">
      <h1>Seu patrimônio</h1>
      <p>Matérias e guias sobre proteção, diversificação e patrimônio no exterior, reunidos em um só lugar.</p>
    </header>
    {itens.length === 0 ? <p class="meta vazio">Nenhum texto publicado ainda.</p> : (
      <div class="grade">
        {itens.map((i) => <CardPost {...i} />)}
      </div>
    )}
  </section>
  {SITE.contatoEspecialista.ativo && (
    <div class="container-texto patrimonio-contato">
      <ContatoEspecialista />
    </div>
  )}
</Base>
