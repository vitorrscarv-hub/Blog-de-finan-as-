---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CardPost from '../components/CardPost.astro';
import { SITE } from '../site.config';
import { porData, publicado } from '../scripts/formatos';

const noticias = (await getCollection('noticias', publicado)).sort(porData).slice(0, 6);
const guias = (await getCollection('guias', publicado)).sort(porData).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.nome,
  description: SITE.descricao,
  url: new URL('/', Astro.site).href,
  inLanguage: 'pt-BR',
  author: { '@type': 'Person', name: SITE.autor.nome, description: SITE.autor.credenciais.join('; ') },
};
---
<Base title={SITE.nome} jsonLd={jsonLd}>
  <section class="destaque container">
    <h1>Finanças e investimentos, explicados por quem acompanha o mercado</h1>
    <p>{SITE.descricao}</p>
  </section>

  <section class="secao container">
    <div class="secao-titulo">
      <h2>Notícias da semana</h2>
      <a href="/noticias/">Ver todas</a>
    </div>
    {noticias.length === 0 ? <p class="meta">Nenhuma notícia publicada ainda.</p> : (
      <div class="grade">
        {noticias.map((n) => (
          <CardPost href={`/noticias/${n.id}/`} title={n.data.title} description={n.data.description} date={n.data.date} />
        ))}
      </div>
    )}
  </section>

  <section class="secao container">
    <div class="secao-titulo">
      <h2>Guias</h2>
      <a href="/guias/">Ver todos</a>
    </div>
    {guias.length === 0 ? <p class="meta">Nenhum guia publicado ainda.</p> : (
      <div class="grade">
        {guias.map((g) => (
          <CardPost href={`/guias/${g.id}/`} title={g.data.title} description={g.data.description} date={g.data.date} etiqueta={g.data.tema} />
        ))}
      </div>
    )}
  </section>
</Base>
